# The graph canvas's own look, over the palette `theme.py` supplies.
#
# Only what is SPECIFIC to the canvas lives here. The gruvbox colours --
# the canvas, the node body, the text, the port roles -- are the app's and
# come from `theme.py`, which every other surface shares; copying them here
# would give each two homes and the copy would drift.
#
# PARTIAL BY CONSTRUCTION: a field this file does not name keeps the
# library's default, so the canvas follows the library forward instead of
# pinning a palette at the version it was written against. Write this file
# with the library demo's Shift+F6 (or `ffi.write_theme_diff`), which emits
# only what a tuning session moved; plain F6 dumps all 29 fields and would
# claim every colour the app owns. Read by `ffi.parse_theme`; an unknown
# field name is an error naming its line, so a misspelling cannot be
# dropped in silence.

# How much of a row's role colour survives the widget panel drawn over it.
# The library ships 0.22, which leaves every host tint within a few levels
# of the panel grey -- white draws as rgb(93,93,93). Hue separation between
# the two tinted row kinds climbs 26/31/33/34 across 0.35/0.5/0.65/0.8, so
# 0.5 is the knee and past it the extra tint buys nothing.
row_role_widget = 0.5
